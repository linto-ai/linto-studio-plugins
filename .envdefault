# This file contains the default values for the environment variables
# You can override them by creating a file named .env in the same directory
# you can also override them by setting them in the environment before running the app (e.g. export SRT_PORT=1234)
NODE_ENV=production # used to load the appropriate migration config
TZ=UTC
LOG_FORMAT=text # Format of the log: text or json
LOG_LEVEL=debug # Level among error, warn, info, debug

# Security
# Warning: these two environment variables must be identical for both the session-api service and the transcriber.
# If the SECURITY_SALT_FILEPATH variable is set, the file must be accessible to both services.
SECURITY_CRYPT_KEY= # Key used to encrypt sensible data in database
SECURITY_SALT_FILEPATH= # Optionnaly pass a filepath to a salt.

# App components registration (don't touch)
TRANSCRIBER_COMPONENTS=BrokerClient,StreamingServer,Healthcheck # Comma separated list of components to run, they load in this order
SCHEDULER_COMPONENTS=BrokerClient # Comma separated list of components to run, they load in this order
SESSION_API_COMPONENTS=WebServer,BrokerClient
DELIVERY_COMPONENTS=BrokerClient,WebServer,IoHandler
BOTSERVICE_COMPONENTS=BrokerClient,Healthcheck # Comma separated list of components to run, they load in this order
VISIOBOT_COMPONENTS=BrokerClient,Healthcheck # Comma separated list of components to run, they load in this order

# ── BotService (dedicated meeting-bot service) ───────────────────────────────
MAX_CONCURRENT_BOTS=10 # max simultaneous browser bots per BotService replica
BOTSERVICE_HEALTHCHECK_HTTP=8080 # HTTP port for the liveness endpoint (JSON: status/activeBots/browserConnected/audioServerListening)
EMPTY_MEETING_TIMEOUT_SECONDS=60 # auto-leave a meeting this long after the last participant leaves
BOT_DISPLAY_NAME=LinTO Bot # name the bot shows when joining a meeting
# BOT_CAPABILITIES=jitsi,bigbluebutton,teams,visio # advertised providers (defaults to all)
# Internal host a BotService bot uses to reach a Transcriber WS ingest (used by the
# Scheduler to mint the websocketUrl). Defaults to the 'transcriber' compose service.
STREAMING_WS_BOT_HOST=transcriber
# JOIN_TIMEOUT_SECONDS=120 # leave if no participant is seen this long after join (absolute watchdog)
# AUDIO_SILENCE_TIMEOUT_SECONDS=30 # tear down if no PCM arrives for this long after admission (0 = disabled)
# EARLY_AUDIO_MAX_AGE_SECONDS=30 # max age of buffered early (SFU) audio before the reaper drops it
# TRANSCRIBER_ACK_TIMEOUT_SECONDS=10 # wait for the Transcriber init {type:ack} before failing the handshake
# BOTSERVICE_MAX_RSS_MB=2048 # RSS ceiling: above it the replica advertises capabilities=[] and refuses bots (0 = disabled)
# BOTSERVICE_WS_RECONNECT_RETRIES=3 # max Transcriber WS reconnection attempts before giving up (fatal)
# BOTSERVICE_WS_RECONNECT_BASE_MS=1000 # base delay (ms) for the exponential WS reconnection backoff

# ── VisioBotService (native LiveKit bot for Visio/Meet) ──────────────────────
# Broker-piloted bot that joins a LiveKit room hidden, streams every participant's
# audio to a Transcriber and republishes the captions back into the room. Its
# Python service does NOT read this file (see VisioBotService/.envdefault, which
# mirrors the code defaults) — the values below are what a deployment must set.
VISIOBOT_HEALTHCHECK_HTTP=8081 # HTTP port for the liveness endpoint
# BOT_CAPABILITIES=visio-native # capability the Scheduler routes visio bots on
# LIVEKIT_TOKEN_FROM_PAYLOAD=true # present the room join token minted by Meet
# (session.meta.native) instead of self-signing. Fail-closed: no token => no join.
# PROD SHOULD SET THIS — the replica then holds no LiveKit signing secret.
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET # dev-only self-mint fallback; the service
# refuses to start on the devkey/secret placeholders unless DEVELOPMENT=true or
# LIVEKIT_TOKEN_FROM_PAYLOAD=true.
BOT_PERSTREAM=true # per-stream diarization: stream ONE TAGGED PCM flow per
# participant (VAD-gated) instead of one mixed flow, so the Transcriber runs one ASR
# per participant and captions carry the participant's real display name. false =
# legacy mixed path (one ASR, speaker guessed from the mixer's energy VAD).
# ⚠ Needs TRANSCRIBER_PERSTREAM_DIARIZATION=true on the Transcriber serving the bot:
# the mode is negotiated in the Transcriber's ack and the bot honours it (it logs a
# WARNING and falls back to mixed when denied).
BOT_VAD_ENERGY_THRESHOLD=300 # RMS above which a 20 ms frame counts as speech
VISIOBOT_PUBLISH_NATIVE_SUBS=true # republish captions into the room as native
# LiveKit transcription segments (rendered by the Visio/Meet subtitle overlay).
# Requires can_publish_data on the join token.

# Audio streaming configuration
MAX_AUDIO_BUFFER=10 # If ASR is down, keeps MAX_AUDIO_BUFFER seconds of audio to fast forward upon reconnection
MIN_AUDIO_BUFFER=200 # Send audio to ASR when buffer is at least MIN_AUDIO_BUFFER milliseconds long
BYTES_PER_SAMPLE=2 # 1 for 8-bit, 2 for 16-bit, 4 for 32-bit
SAMPLE_RATE=16000 # 8000, 16000, 32000, 44100, 48000
AUDIO_STORAGE_PATH=/audio-storage # Path to store channel audio files, use trailing slash !

##### Inbound / Pulled streaming #####
STREAMING_PASSPHRASE=A0123456789 # empty, false or a passphrase (at least 10 chars).
STREAMING_HOST=0.0.0.0 # Listening address for transcriber. 0.0.0.0 for all interfaces (listener), you might use a specific IP address for SRT rendez-vous/caller mode
STREAMING_PROTOCOLS=SRT,RTMP,WS # comma separated list : SRT, RTMP, WS
STREAMING_SRT_MODE=listener # listerner, caller, rendezvous
STREAMING_SRT_UDP_PORT=8889 # UDP port for SRT listener
STREAMING_SRT_PAYLOAD_TIMEOUT_SECONDS=15 # Tear down an SRT channel whose socket keeps signalling but delivers no payload for this long (wedged socket). Must stay above the 5s inactivity sentinel
STREAMING_RTMP_TCP_PORT=1935 # TCP port for RTMP listener
STREAMING_WS_TCP_PORT=8080 # TCP port for Websocket listener
# As app constructs streaming endpoint URLs, it needs to know the proxy host and port to build the correct URL
STREAMING_PROXY_SRT_HOST=false # Transcriber host for SRT inbound streaming (false to disable)
STREAMING_PROXY_RTMP_HOST=localhost # Transcriber host for RTMP inbound streaming (false to disable)
STREAMING_PROXY_WS_HOST=localhost # Transcriber host for WS inbound streaming (false to disable)
STREAMING_PROXY_SRT_UDP_PORT=8889 # UDP port for SRT listener
STREAMING_PROXY_RTMP_TCP_PORT=1935 # TCP port for RTMP listener
STREAMING_PROXY_WS_TCP_PORT=8080 # TCP port for Websocket listener
STREAMING_HEALTHCHECK_TCP=9999 # TCP port for healthcheck listener
STREAMING_WS_SECURE=false
STREAMING_WS_ENDPOINT=transcriber-ws
STREAMING_RTMP_SECURE=false

##### Database #####
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=postgres

##### ASR #####
TRANSCRIBER_BOT_NAME=bot
# Per-stream diarization (serves the VisioBotService native bot): accept tagged
# per-participant audio flows and run ONE ASR per participant, so a caption's
# speaker is the participant identity rather than an ASR-provider guess. The
# Transcriber only grants the mode when this is true — it advertises the decision
# in its init ack, and a bot that asked for it falls back to the mixed path
# otherwise. Off ⇒ the legacy mixed path is bit-exact.
TRANSCRIBER_PERSTREAM_DIARIZATION=false
# Ceiling on concurrent ASR per channel in per-stream mode (i.e. how many
# participants get their own ASR). Beyond it, the surplus participants collapse onto
# ONE shared overflow ASR — captions stay, exact per-speaker separation does not.
MAX_CONCURRENT_ASR_PER_CHANNEL=6
# Speaker label carried by captions from that shared overflow ASR.
TRANSCRIBER_OVERFLOW_SPEAKER_NAME=Participants
TRANSCRIBER_RESET_MESSAGE="Channel reset."
# Max time the Transcriber waits for the ASR provider to flush its pending
# finals at stream stop, before emitting the end-of-stream marker (ms)
ASR_STOP_FLUSH_TIMEOUT_MS=3000
# Grace period after the provider flush for straggler SDK callbacks, before
# the end-of-stream marker is emitted (ms)
ASR_STOP_SETTLE_MS=300
# Max time PUT /sessions/:id/stop?waitFinal=true waits for every channel to be
# deactivated by its transcriber before reading captions as-is (ms)
SESSION_STOP_FLUSH_TIMEOUT_MS=10000
ASR_AVAILABLE_TRANSLATIONS_MICROSOFT="ar,eu,bs,bg,zh,zhh,cs,da,nl,en,et,fi,fr,gl,de,el,hi,hu,id,it,ja,ko,lv,lt,mk,nb,pl,pt,ro,ru,sr,sk,sl,es,sv,th,tr,uk,vi,cy"
ASR_HAS_DIARIZATION_MICROSOFT=true
ASR_AVAILABLE_TRANSLATIONS_AMAZON=""
ASR_HAS_DIARIZATION_AMAZON=true

##### OpenAI Streaming ASR #####
ASR_AVAILABLE_TRANSLATIONS_OPENAI_STREAMING=""
ASR_HAS_DIARIZATION_OPENAI_STREAMING=false

##### Voxstral ASR #####
ASR_AVAILABLE_TRANSLATIONS_VOXSTRAL=""
ASR_HAS_DIARIZATION_VOXSTRAL=false

##### MQTT compatible Broker #####
BROKER_HOST=localhost
BROKER_PORT=1883
BROKER_USERNAME=
BROKER_PASSWORD=
BROKER_KEEPALIVE=60
BROKER_PROTOCOL=mqtt
BROKER_USE_TLS=false # Enable TLS/SSL (automatically switches protocol to mqtts)
BROKER_CA_FILEPATH= # Path to CA certificate file (optional, for custom/self-signed CA)
BROKER_CERT_FILEPATH= # Path to client certificate file (optional, for mutual TLS)
BROKER_KEY_FILEPATH= # Path to client private key file (optional, for mutual TLS)
BROKER_REJECT_UNAUTHORIZED=true # Reject connections to brokers with untrusted certificates (set to false for self-signed certs)

##### Session API #####
SESSION_API_HOST=http://localhost:8000 # Host used by the Swagger doc to request the Session API
SESSION_API_WEBSERVER_HTTP_PORT=8000
