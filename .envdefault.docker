NODE_ENV=production
TZ=UTC
LOG_FORMAT=text # Format of the log: text or json
LOG_LEVEL=debug # Level among error, warn, info, debug

# App components registration (don't touch)
TRANSCRIBER_COMPONENTS=BrokerClient,StreamingServer,Healthcheck # Comma separated list of components to run, they load in this order
SCHEDULER_COMPONENTS=BrokerClient # Comma separated list of components to run, they load in this order
SESSION_API_COMPONENTS=WebServer,BrokerClient
DELIVERY_COMPONENTS=BrokerClient,WebServer,IoHandler
BOTSERVICE_COMPONENTS=BrokerClient,Healthcheck
VISIOBOT_COMPONENTS=BrokerClient,Healthcheck

# BotService (dedicated meeting-bot service)
MAX_CONCURRENT_BOTS=10
EMPTY_MEETING_TIMEOUT_SECONDS=60
BOT_DISPLAY_NAME=LinTO Bot
STREAMING_WS_BOT_HOST=transcriber
BOTSERVICE_HEALTHCHECK_HTTP=8080
# JOIN_TIMEOUT_SECONDS=120 # leave if no participant is seen this long after join
# AUDIO_SILENCE_TIMEOUT_SECONDS=30 # tear down if no PCM for this long after admission (0 = disabled)
# EARLY_AUDIO_MAX_AGE_SECONDS=30 # max age of buffered early (SFU) audio before the reaper drops it
# TRANSCRIBER_ACK_TIMEOUT_SECONDS=10 # wait for the Transcriber init ack before failing the handshake
# BOTSERVICE_MAX_RSS_MB=2048 # RSS ceiling: above it advertise capabilities=[] and refuse bots (0 = disabled)
# BOTSERVICE_WS_RECONNECT_RETRIES=3 # max Transcriber WS reconnection attempts before giving up
# BOTSERVICE_WS_RECONNECT_BASE_MS=1000 # base delay (ms) for the exponential WS reconnection backoff
# ⚠ BOT_CAPABILITIES is read by BOTH bot services (web BotService and
# VisioBotService), which share this env_file. It is therefore set PER SERVICE in
# compose.yml (`environment:`) and must stay unset here — a global value would make
# one of the two advertise a capability it cannot serve.

# Scheduler bot routing. Suffix = provider upper-cased with '-' -> '_'.
BOT_PROVIDER_FALLBACK_VISIO=visio-native,visio # prefer the native LiveKit agent,
# fall back to the web bot when no native replica is online
# SESSION_GATED_CAPABILITIES=visio-native # capabilities kept only for sessions that
# declare them (meta.native[<cap>]) AND carry a join token; otherwise demoted to the
# web sibling before dispatch. Defaults to visio-native. The list can only ADD to the
# gate: a "-native" capability is always gated whatever this is set to, so a partial
# override can never disable the built-in token check.

# VisioBotService (native LiveKit bot for Visio/Meet)
VISIOBOT_HEALTHCHECK_HTTP=8081
# Auto-leave reads the shared EMPTY_MEETING_TIMEOUT_SECONDS / JOIN_TIMEOUT_SECONDS
# above (same rule as the web bot: empty meeting => end the session; never
# populated => 'join-timeout' bot-error).
# LIVEKIT_TOKEN_FROM_PAYLOAD=true # use the join token minted by Meet (prod); the
# replica then holds no LiveKit signing secret
# VISIOBOT_LIVEKIT_ALLOWED_HOSTS= # SSRF accept-list for the livekitUrl from session
# meta; authoritative when set. Unset => private/loopback SFUs refused unless
# DEVELOPMENT=true (compose.override.yml sets it for the local stack)
BOT_PERSTREAM=true # one tagged PCM flow per participant => 1 ASR/participant and a
# real speaker name; needs TRANSCRIBER_PERSTREAM_DIARIZATION=true (negotiated in the
# Transcriber ack). false = legacy mixed path (speaker guessed by energy VAD)
BOT_VAD_ENERGY_THRESHOLD=300 # RMS above which a 20 ms frame counts as speech
BOT_VAD_HANGOVER_MS=800 # trailing "active" window after the last frame above the
# threshold. The VAD-gated bursts are spliced end to end for the sub-ASR, so this
# silence is the ONLY end-of-utterance signal the provider gets: it MUST exceed the
# provider's own timeout (~500 ms on Microsoft) or bursts merge into one run-on
# segment; too long and silence is billed. Per-stream mode only.
BOT_MIXER_BUFFER_FRAMES=160 # per-participant mix buffer depth in 20 ms frames
# (~3.2 s), bounded drop-oldest: the mix tick is always slightly over 20 ms, so an
# unbounded buffer grows without limit and caption latency drifts
VISIOBOT_PUBLISH_NATIVE_SUBS=true # republish captions into the room as native
# LiveKit transcription segments (needs can_publish_data on the join token)
VISIOBOT_WS_RECONNECT_RETRIES=3 # reconnect attempts on a Transcriber WS close (0 = fatal)
VISIOBOT_WS_RECONNECT_BASE_MS=1000 # first backoff; doubles per attempt, + full jitter
VISIOBOT_WS_MAX_QUEUE_FRAMES=500 # bounded send queue while the socket is down

# Audio streaming configuration
MAX_AUDIO_BUFFER=10 # If ASR is down, keeps MAX_AUDIO_BUFFER seconds of audio to fast forward upon reconnection
MIN_AUDIO_BUFFER=200 # Send audio to ASR when buffer is at least MIN_AUDIO_BUFFER milliseconds long
BYTES_PER_SAMPLE=2 # 1 for 8-bit, 2 for 16-bit, 4 for 32-bit
SAMPLE_RATE=16000 # 8000, 16000, 32000, 44100, 48000
AUDIO_STORAGE_PATH=/audio-storage # Path to store channel audio files, use trailing slash !

##### Inbound / Pulled streaming #####
STREAMING_PASSPHRASE=false
STREAMING_HOST=0.0.0.0
STREAMING_PROTOCOLS=SRT,RTMP,WS
STREAMING_SRT_MODE=listener
STREAMING_SRT_UDP_PORT=8889
STREAMING_SRT_PAYLOAD_TIMEOUT_SECONDS=15
STREAMING_RTMP_TCP_PORT=1935
STREAMING_WS_TCP_PORT=8890

# As app constructs streaming endpoint URLs, it needs to know the proxy host and port to build the correct URL
STREAMING_PROXY_SRT_HOST=127.0.0.1
STREAMING_PROXY_RTMP_HOST=127.0.0.1
STREAMING_PROXY_WS_HOST=127.0.0.1
STREAMING_PROXY_SRT_UDP_PORT=8889
STREAMING_PROXY_RTMP_TCP_PORT=1935
STREAMING_PROXY_WS_TCP_PORT=8890
STREAMING_HEALTHCHECK_TCP=9999
STREAMING_WS_SECURE=false
STREAMING_WS_ENDPOINT=transcriber-ws
STREAMING_RTMP_SECURE=false

##### Database (PostgreSQL) #####
DB_HOST=database # Hostname (use "database" for Docker, "localhost" for local dev)
DB_PORT=5433
DB_USER=myuser
DB_PASSWORD=mypass
DB_NAME=mydb

##### ASR #####
TRANSCRIBER_BOT_NAME=bot
# Per-stream diarization (serves the VisioBotService native bot): one ASR per
# participant instead of one per mixed channel. The Transcriber grants the mode in
# its init ack only when this is true; off => legacy mixed path, bit-exact.
TRANSCRIBER_PERSTREAM_DIARIZATION=false
MAX_CONCURRENT_ASR_PER_CHANNEL=6 # participants with their own ASR; the surplus
# collapses onto one shared overflow ASR
TRANSCRIBER_OVERFLOW_SPEAKER_NAME=Participants # speaker label of that overflow ASR
TRANSCRIBER_RESET_MESSAGE="Channel reset."
# Max time the Transcriber waits for the ASR provider to flush its pending
# finals at stream stop, before emitting the end-of-stream marker (ms)
ASR_STOP_FLUSH_TIMEOUT_MS=3000
# Grace period after the provider flush for straggler SDK callbacks, before
# the end-of-stream marker is emitted (ms)
ASR_STOP_SETTLE_MS=300
# Max time PUT /sessions/:id/stop?waitFinal=true waits for every channel to be
# deactivated by its transcriber before reading captions as-is (ms)
SESSION_STOP_FLUSH_TIMEOUT_MS=10000
ASR_AVAILABLE_TRANSLATIONS_MICROSOFT="ar,eu,bs,bg,zh,zhh,cs,da,nl,en,et,fi,fr,gl,de,el,hi,hu,id,it,ja,ko,lv,lt,mk,nb,pl,pt,ro,ru,sr,sk,sl,es,sv,th,tr,uk,vi,cy"
ASR_HAS_DIARIZATION_MICROSOFT=true

##### MQTT Broker (Eclipse Mosquitto) #####
BROKER_HOST=broker # Hostname (use "broker" for Docker, "localhost" for local dev)
BROKER_PORT=1883
BROKER_USERNAME= # Leave empty for no authentication
BROKER_PASSWORD= # Leave empty for no authentication
BROKER_KEEPALIVE=60 # Keepalive interval in seconds
BROKER_PROTOCOL=mqtt # mqtt or mqtts
BROKER_USE_TLS=false # Enable TLS/SSL (automatically switches protocol to mqtts)
BROKER_CA_FILEPATH= # Path to CA certificate file (optional, for custom/self-signed CA)
BROKER_CERT_FILEPATH= # Path to client certificate file (optional, for mutual TLS)
BROKER_KEY_FILEPATH= # Path to client private key file (optional, for mutual TLS)
BROKER_REJECT_UNAUTHORIZED=true # Reject connections to brokers with untrusted certificates (set to false for self-signed certs)

##### Session API #####
SESSION_API_HOST=http://localhost:8005 # Internal URL used by other services to reach Session-API
SESSION_API_WEBSERVER_HTTP_PORT=8005
