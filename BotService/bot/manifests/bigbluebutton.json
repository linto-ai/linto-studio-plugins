{
  "platformType": "mcu",
  "diarizationMode": "asr",
  "blockExternalDomains": true,
  "admission": "audio",
  "meetingEndedSelector": "[data-test=\"meetingEndedModal\"]",
  "loginRules": [
    {
      "action": "waitForSelector",
      "selector": "#joinFormName, input[placeholder=\"Enter your name!\"], [data-test=\"guestMessage\"], [data-test=\"audioModal\"], [data-test=\"joinAudio\"], [data-test=\"audioDropdownMenu\"]",
      "timeout": 60000
    },
    {
      "if": "#joinFormName, input[placeholder=\"Enter your name!\"]",
      "action": "fill",
      "selector": "#joinFormName, input[placeholder=\"Enter your name!\"]",
      "value": "{{botName}}",
      "timeout": 10000
    },
    {
      "if": "#consentCheck:not(:checked)",
      "action": "click",
      "selector": "#consentCheck",
      "timeout": 10000
    },
    {
      "if": "form:has(#joinFormName) button[type=\"submit\"], #room-join",
      "action": "click",
      "selector": "form:has(#joinFormName) button[type=\"submit\"], #room-join",
      "timeout": 10000
    },
    {
      "action": "waitForSelector",
      "selector": "[data-test=\"listenOnlyBtn\"], [data-test=\"audioModal\"] select:has(option[value=\"listen-only\"]), [data-test=\"audioDropdownMenu\"]",
      "timeout": 1800000
    },
    {
      "if": "[data-test=\"listenOnlyBtn\"]",
      "action": "click",
      "selector": "[data-test=\"listenOnlyBtn\"]",
      "timeout": 10000
    },
    {
      "if": "[data-test=\"audioModal\"] select:has(option[value=\"listen-only\"])",
      "action": "select",
      "selector": "[data-test=\"audioModal\"] select:has(option[value=\"listen-only\"])",
      "value": "listen-only",
      "timeout": 10000
    },
    {
      "if": "[data-test=\"audioModal\"] select:has(option[value=\"listen-only\"])",
      "action": "click",
      "selector": "[data-test=\"audioModal\"] [data-test=\"joinEchoTestButton\"]",
      "timeout": 10000
    }
  ],
  "leaveRules": [
    {
      "if": "[data-test=\"closeModal\"]",
      "action": "click",
      "selector": "[data-test=\"closeModal\"] >> visible=true >> nth=0",
      "timeout": 3000,
      "optional": true
    },
    {
      "if": "[data-test=\"leaveMeetingDropdown\"]",
      "action": "click",
      "selector": "[data-test=\"leaveMeetingDropdown\"]",
      "timeout": 3000,
      "optional": true
    },
    {
      "if": "[data-test=\"leaveMeetingDropdown\"]",
      "action": "click",
      "selector": "[data-test=\"directLogoutButton\"]",
      "timeout": 3000,
      "optional": true
    }
  ]
}
